<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Control de Repartidores</title>
<style>
:root{--bg:#0e0e0f;--card:#1a1a1c;--card2:#232326;--line:#2e2e33;--red:#e11d2e;--red2:#ff4757;--txt:#f4f4f5;--mut:#a1a1aa;--ok:#22c55e}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--txt);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;font-size:17px;line-height:1.4;overflow-x:hidden}
header{padding:16px 16px 8px;position:sticky;top:0;background:var(--bg);z-index:5}
h1{margin:0 0 10px;font-size:22px}
h1 span{color:var(--red)}
nav{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
nav button{padding:12px 2px;font-size:13px;font-weight:700;background:var(--card);color:var(--mut);border:1px solid var(--line);border-radius:12px;cursor:pointer}
nav button.on{background:var(--red);color:#fff;border-color:var(--red)}
main{padding:8px 16px 90px;max-width:720px;margin:0 auto}
section{display:none}section.on{display:block}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;margin:12px 0;box-shadow:0 4px 14px rgba(0,0,0,.35)}
.card h2{margin:0 0 12px;font-size:19px}
label{display:block;font-size:14px;color:var(--mut);margin:12px 0 4px}
input,select,textarea{width:100%;padding:13px;font-size:17px;color:var(--txt);background:var(--card2);border:1px solid var(--line);border-radius:12px;font-family:inherit}
input:focus,select:focus,textarea:focus{outline:2px solid var(--red);border-color:var(--red)}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.chk{display:flex;align-items:center;gap:12px;margin-top:14px;padding:13px;background:var(--card2);border-radius:12px;border:1px solid var(--line);color:var(--txt);font-size:17px}
.chk input{width:26px;height:26px;accent-color:var(--red);margin:0}
button.btn{width:100%;padding:16px;font-size:18px;font-weight:800;color:#fff;background:var(--red);border:0;border-radius:14px;cursor:pointer;margin-top:14px}
button.btn:active{background:var(--red2)}
button.big{padding:22px 16px;font-size:20px}
button.sec{background:var(--card2);border:1px solid var(--line);color:var(--txt)}
button.sm{width:auto;padding:10px 14px;font-size:15px;margin:0;border-radius:10px}
.danger{background:#5b0f17}
.err{background:#3a0b10;color:#ffb4bb;border:1px solid var(--red);padding:12px;border-radius:12px;margin-top:12px;display:none}
.warn{background:#3a0b10;color:#ff8a94;border:1px solid var(--red);padding:8px 10px;border-radius:10px;margin-top:8px;font-size:15px;font-weight:700}
.prev{margin-top:12px;color:var(--mut);font-size:15px}
.prev b{color:var(--txt)}
.sug{border-color:var(--red)}
.sug .name{font-size:26px;font-weight:800;color:var(--red2)}
.pill{display:inline-block;padding:3px 10px;border-radius:99px;font-size:13px;font-weight:700;background:var(--card2);border:1px solid var(--line);margin-right:4px}
.pill.lejano{background:var(--red);border-color:var(--red);color:#fff}
.pill.forz{background:#fff;color:#000}
.item{padding:12px 0;border-top:1px solid var(--line)}
.item:first-child{border-top:0}
.item .top{display:flex;justify-content:space-between;gap:8px;align-items:flex-start;flex-wrap:wrap}
.mut{color:var(--mut);font-size:14px}
.acts{display:flex;gap:8px;margin-top:8px;flex-wrap:wrap}
.num{font-size:28px;font-weight:800}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.stat{background:var(--card2);border-radius:12px;padding:12px}
.stat .mut{display:block}
ol.prio{padding-left:24px;margin:0}
ol.prio li{padding:8px 0;border-top:1px solid var(--line)}
ol.prio li:first-child{border-top:0}
.empty{color:var(--mut);text-align:center;padding:16px}
.tie button{margin-top:8px}
</style>
</head>
<body>
<header>
  <h1>🛵 Control de <span>Repartidores</span></h1>
  <nav id="tabs">
    <button data-t="reg" class="on">Registrar viaje</button>
    <button data-t="rep">Repartidores</button>
    <button data-t="his">Historial</button>
    <button data-t="res">Resumen</button>
  </nav>
</header>
<main>

<!-- REGISTRAR -->
<section id="reg" class="on">
  <button class="btn big" id="btnSug">¿Quién debe ir al siguiente viaje lejano?</button>
  <div id="sugBox"></div>

  <div class="card">
    <h2 id="formTitle">Registrar viaje</h2>
    <label for="fDriver">Repartidor</label>
    <select id="fDriver"></select>
    <label for="fZone">Zona o dirección breve</label>
    <input id="fZone" type="text" placeholder="Ej. Col. Centro" maxlength="80">
    <div class="row">
      <div><label for="fOrders">Pedidos (1 a 10)</label><input id="fOrders" type="number" inputmode="numeric" min="1" max="10" step="1" value="1"></div>
      <div><label for="fType">Tipo de viaje</label>
        <select id="fType">
          <option value="auto">Automático</option>
          <option value="cercano">Cercano</option>
          <option value="medio">Medio</option>
          <option value="lejano">Lejano</option>
        </select></div>
    </div>
    <div class="row">
      <div><label for="fOut">Km de ida</label><input id="fOut" type="number" inputmode="decimal" min="0" step="0.1" placeholder="0"></div>
      <div><label for="fBack">Km de regreso</label><input id="fBack" type="number" inputmode="decimal" min="0" step="0.1" placeholder="0"></div>
    </div>
    <div class="row">
      <div><label for="fDep">Hora de salida</label><input id="fDep" type="time"></div>
      <div><label for="fRet">Regreso estimado</label><input id="fRet" type="time"></div>
    </div>
    <label class="chk"><input type="checkbox" id="fForced"> Viaje forzado (no había otra opción)</label>
    <label for="fNote">Nota (opcional)</label>
    <textarea id="fNote" rows="2" maxlength="200"></textarea>
    <div class="prev" id="prev"></div>
    <div class="err" id="formErr"></div>
    <button class="btn" id="btnSave">Guardar viaje</button>
    <button class="btn sec" id="btnCancel" style="display:none">Cancelar edición</button>
  </div>
</section>

<!-- REPARTIDORES -->
<section id="rep">
  <div class="card">
    <h2>Agregar repartidor</h2>
    <input id="newName" type="text" placeholder="Nombre" maxlength="40">
    <button class="btn" id="btnAddDrv">Agregar</button>
  </div>
  <div id="drvList"></div>
</section>

<!-- HISTORIAL -->
<section id="his">
  <div class="card">
    <h2>Filtros</h2>
    <label for="hPer">Periodo</label>
    <select id="hPer"><option value="week">Esta semana</option><option value="today">Hoy</option></select>
    <div class="row">
      <div><label for="hDrv">Repartidor</label><select id="hDrv"></select></div>
      <div><label for="hType">Tipo</label>
        <select id="hType"><option value="">Todos</option><option value="cercano">Cercano</option><option value="medio">Medio</option><option value="lejano">Lejano</option></select></div>
    </div>
  </div>
  <div class="card" id="hisList"></div>
</section>

<!-- RESUMEN -->
<section id="res">
  <div class="card">
    <h2>Gasolina</h2>
    <label for="rate">Tarifa por kilómetro ($)</label>
    <input id="rate" type="number" inputmode="decimal" min="0" step="0.1">
  </div>
  <div id="teamBox"></div>
  <div id="sumList"></div>
  <div class="card">
    <h2>Datos</h2>
    <button class="btn sec" id="btnCsv">Exportar CSV</button>
    <button class="btn sec" id="btnJson">Respaldar (JSON)</button>
    <button class="btn sec" id="btnImport">Restaurar respaldo (JSON)</button>
    <input type="file" id="fileImport" accept=".json,application/json" style="display:none">
    <button class="btn danger" id="btnWipe">Borrar datos de la semana</button>
  </div>
</section>

</main>

<script>
(function(){
'use strict';
const KEY='repartidores_v1';
let S=load();
let editingId=null;

function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7)}
function defaults(){
  return {drivers:['Repartidor 1','Repartidor 2','Repartidor 3','Repartidor 4'].map(n=>({id:uid(),name:n})),trips:[],rate:2.5};
}
function load(){
  try{
    const raw=localStorage.getItem(KEY);
    if(raw){const o=JSON.parse(raw);if(o&&Array.isArray(o.drivers)&&Array.isArray(o.trips)){if(typeof o.rate!=='number')o.rate=2.5;return o;}}
  }catch(e){}
  return defaults();
}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){alert('No se pudo guardar en este navegador.')}}
const $=id=>document.getElementById(id);
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const r1=n=>Math.round(n*10)/10;
const fmt=n=>r1(n).toLocaleString('es-MX',{maximumFractionDigits:1});
const money=n=>'$'+n.toLocaleString('es-MX',{minimumFractionDigits:2,maximumFractionDigits:2});
const TL={cercano:'Cercano',medio:'Medio',lejano:'Lejano'};

function weekStart(d){const x=new Date(d);x.setHours(0,0,0,0);const wd=(x.getDay()+6)%7;x.setDate(x.getDate()-wd);return x.getTime()}
function dayStart(d){const x=new Date(d);x.setHours(0,0,0,0);return x.getTime()}
function weekTrips(){const ws=weekStart(Date.now());return S.trips.filter(t=>t.ts>=ws)}
function classify(km){return km<=15?'cercano':(km<=35?'medio':'lejano')}
function drvName(id){const d=S.drivers.find(x=>x.id===id);return d?d.name:'(eliminado)'}

// Estadísticas por repartidor (derivadas del historial semanal: eliminar/editar siempre cuadra)
function stats(){
  const m={};
  S.drivers.forEach(d=>m[d.id]={d,km:0,far:0,farN:0,forced:0,orders:0,n:{cercano:0,medio:0,lejano:0}});
  weekTrips().forEach(t=>{
    const s=m[t.driverId];if(!s)return;
    s.km+=t.kmTotal;s.orders+=t.orders;s.n[t.type]++;
    if(t.type==='lejano'){s.far+=t.kmTotal;s.farN++}
    if(t.forced)s.forced++;
  });
  return Object.values(m);
}
function prioSort(a,b){return a.km-b.km||a.far-b.far||a.farN-b.farN||a.forced-b.forced}

// ---------- Pestañas ----------
document.querySelectorAll('#tabs button').forEach(b=>b.onclick=()=>go(b.dataset.t));
function go(t){
  document.querySelectorAll('#tabs button').forEach(b=>b.classList.toggle('on',b.dataset.t===t));
  document.querySelectorAll('main section').forEach(s=>s.classList.toggle('on',s.id===t));
  window.scrollTo(0,0);renderAll();
}

// ---------- Formulario ----------
function fillDriverSelects(){
  const cur=$('fDriver').value,curH=$('hDrv').value;
  const opts=S.drivers.map(d=>`<option value="${d.id}">${esc(d.name)}</option>`).join('');
  $('fDriver').innerHTML=opts||'<option value="">Sin repartidores</option>';
  if(S.drivers.some(d=>d.id===cur))$('fDriver').value=cur;
  $('hDrv').innerHTML='<option value="">Todos</option>'+opts;
  if(S.drivers.some(d=>d.id===curH))$('hDrv').value=curH;
}
function nowHM(){const d=new Date();return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')}
function resetForm(){
  editingId=null;
  $('fZone').value='';$('fOrders').value=1;$('fType').value='auto';
  $('fOut').value='';$('fBack').value='';$('fDep').value=nowHM();$('fRet').value='';
  $('fForced').checked=false;$('fNote').value='';
  $('formTitle').textContent='Registrar viaje';$('btnSave').textContent='Guardar viaje';
  $('btnCancel').style.display='none';$('formErr').style.display='none';updPrev();
}
function updPrev(){
  const o=parseFloat($('fOut').value)||0,b=parseFloat($('fBack').value)||0,n=parseInt($('fOrders').value)||0;
  const tot=o+b;
  const type=$('fType').value==='auto'?classify(tot):$('fType').value;
  $('prev').innerHTML=tot>0?`Km redondos: <b>${fmt(tot)}</b> · Km por pedido: <b>${n>0?fmt(tot/n):'—'}</b> · Tipo: <b>${TL[type]}</b>`:'';
}
['fOut','fBack','fOrders','fType'].forEach(id=>{$(id).addEventListener('input',updPrev);$(id).addEventListener('change',updPrev)});

function showErr(m){const e=$('formErr');e.textContent=m;e.style.display='block'}

$('btnSave').onclick=()=>{
  $('formErr').style.display='none';
  const driverId=$('fDriver').value;
  if(!driverId||!S.drivers.some(d=>d.id===driverId))return showErr('Elige un repartidor.');
  const orders=Number($('fOrders').value);
  if(!Number.isInteger(orders)||orders<1)return showErr('El número de pedidos no puede ser 0. Debe ser de 1 a 10.');
  if(orders>10)return showErr('Un viaje puede tener máximo 10 pedidos.');
  const kmOut=parseFloat($('fOut').value)||0,kmBack=parseFloat($('fBack').value)||0;
  if(kmOut<0||kmBack<0)return showErr('Los kilómetros no pueden ser negativos.');
  if(kmOut+kmBack<=0)return showErr('Los kilómetros no pueden ser 0. Captura ida y/o regreso.');
  const kmTotal=r1(kmOut+kmBack);
  const sel=$('fType').value;
  const type=sel==='auto'?classify(kmTotal):sel;
  const data={driverId,zone:$('fZone').value.trim(),orders,kmOut,kmBack,kmTotal,kmPerOrder:kmTotal/orders,type,forced:$('fForced').checked,depart:$('fDep').value,returnEta:$('fRet').value,note:$('fNote').value.trim()};
  if(editingId){
    const t=S.trips.find(x=>x.id===editingId);
    if(t)Object.assign(t,data);
  }else{
    S.trips.push(Object.assign({id:uid(),ts:Date.now()},data));
  }
  save();
  const wasEdit=!!editingId;
  resetForm();$('sugBox').innerHTML='';
  toast(wasEdit?'Viaje actualizado ✔':'Viaje guardado ✔');
  renderAll();
};
$('btnCancel').onclick=resetForm;

function toast(m){
  const t=document.createElement('div');t.textContent=m;
  t.style.cssText='position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#e11d2e;color:#fff;padding:14px 22px;border-radius:99px;font-weight:700;z-index:99;box-shadow:0 6px 20px rgba(0,0,0,.5)';
  document.body.appendChild(t);setTimeout(()=>t.remove(),1800);
}

// ---------- Sugerencia ----------
function renderPrio(list){
  return `<ol class="prio">${list.map(s=>`<li><b>${esc(s.d.name)}</b><br><span class="mut">Semana: ${fmt(s.km)} km · Lejanos: ${fmt(s.far)} km (${s.farN} viajes) · Forzados: ${s.forced}</span></li>`).join('')}</ol>`;
}
$('btnSug').onclick=()=>{
  const list=stats().sort(prioSort);
  const box=$('sugBox');
  if(!list.length){box.innerHTML='<div class="card"><div class="empty">Agrega repartidores primero.</div></div>';return}
  const top=list[0];
  const tied=list.filter(s=>prioSort(s,top)===0);
  let html='<div class="card sug">';
  if(tied.length===1){
    html+=`<div class="mut">Debe ir:</div><div class="name">${esc(top.d.name)}</div>
    <div class="mut">${fmt(top.km)} km en la semana · ${fmt(top.far)} km en lejanos</div>`;
  }else{
    html+=`<div class="mut">Empate total. Elige quién va:</div><div class="tie">${tied.map(s=>`<button class="btn sm" style="width:100%" data-pick="${s.d.id}">${esc(s.d.name)}</button>`).join('')}</div>`;
  }
  html+=`<h2 style="margin-top:16px">Prioridad para viaje lejano</h2>${renderPrio(list)}</div>`;
  box.innerHTML=html;
  box.querySelectorAll('[data-pick]').forEach(b=>b.onclick=()=>{
    $('fDriver').value=b.dataset.pick;$('fType').value='lejano';updPrev();
    toast('Seleccionado: '+drvName(b.dataset.pick));
    $('fZone').focus();
  });
};

// ---------- Repartidores ----------
$('btnAddDrv').onclick=()=>{
  const n=$('newName').value.trim();
  if(!n)return alert('Escribe un nombre.');
  S.drivers.push({id:uid(),name:n});$('newName').value='';save();renderAll();
};
function renderDrivers(){
  const st=stats();
  if(!st.length){$('drvList').innerHTML='<div class="card"><div class="empty">No hay repartidores.</div></div>';return}
  $('drvList').innerHTML=st.map(s=>`<div class="card">
    <input data-name="${s.d.id}" value="${esc(s.d.name)}" maxlength="40" aria-label="Nombre">
    <div class="grid2" style="margin-top:12px">
      <div class="stat"><span class="mut">Km semana</span><span class="num">${fmt(s.km)}</span></div>
      <div class="stat"><span class="mut">Km lejanos</span><span class="num">${fmt(s.far)}</span></div>
      <div class="stat"><span class="mut">Viajes lejanos</span><span class="num">${s.farN}</span></div>
      <div class="stat"><span class="mut">Viajes forzados</span><span class="num">${s.forced}</span></div>
    </div>
    ${s.far>100?'<div class="warn">⚠ Más de 100 km en viajes lejanos esta semana</div>':''}
    <div class="acts"><button class="btn sm danger" data-del="${s.d.id}">Eliminar</button></div>
  </div>`).join('');
  document.querySelectorAll('[data-name]').forEach(i=>i.onchange=()=>{
    const d=S.drivers.find(x=>x.id===i.dataset.name);
    const v=i.value.trim();
    if(d&&v){d.name=v;save();fillDriverSelects()}else if(d){i.value=d.name}
  });
  document.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{
    const d=S.drivers.find(x=>x.id===b.dataset.del);if(!d)return;
    const cnt=S.trips.filter(t=>t.driverId===d.id).length;
    if(!confirm(`¿Eliminar a ${d.name}?${cnt?` Se borrarán también sus ${cnt} viajes del historial.`:''}`))return;
    S.drivers=S.drivers.filter(x=>x.id!==d.id);
    S.trips=S.trips.filter(t=>t.driverId!==d.id);
    save();renderAll();
  });
}

// ---------- Historial ----------
function renderHistory(){
  const per=$('hPer').value,dv=$('hDrv').value,ty=$('hType').value;
  const from=per==='today'?dayStart(Date.now()):weekStart(Date.now());
  const list=S.trips.filter(t=>t.ts>=from&&(!dv||t.driverId===dv)&&(!ty||t.type===ty)).sort((a,b)=>b.ts-a.ts);
  if(!list.length){$('hisList').innerHTML='<div class="empty">No hay viajes con estos filtros.</div>';return}
  const km=list.reduce((a,t)=>a+t.kmTotal,0),od=list.reduce((a,t)=>a+t.orders,0);
  $('hisList').innerHTML=`<div class="mut" style="margin-bottom:8px">${list.length} viajes · ${fmt(km)} km · ${od?fmt(km/od):0} km/pedido</div>`+list.map(t=>{
    const d=new Date(t.ts);
    return `<div class="item"><div class="top"><div><b>${esc(drvName(t.driverId))}</b><br><span class="mut">${d.toLocaleDateString('es-MX',{weekday:'short',day:'numeric',month:'short'})} ${d.toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'})}</span></div>
      <div><span class="pill ${t.type==='lejano'?'lejano':''}">${TL[t.type]}</span>${t.forced?'<span class="pill forz">Forzado</span>':''}</div></div>
      <div>${esc(t.zone||'Sin zona')}</div>
      <div class="mut">${t.orders} pedido(s) · ida ${fmt(t.kmOut)} + regreso ${fmt(t.kmBack)} = <b style="color:#fff">${fmt(t.kmTotal)} km</b> · ${fmt(t.kmPerOrder)} km/pedido${t.depart?` · sale ${esc(t.depart)}`:''}${t.returnEta?` · regresa ${esc(t.returnEta)}`:''}</div>
      ${t.note?`<div class="mut">📝 ${esc(t.note)}</div>`:''}
      <div class="acts"><button class="btn sm sec" data-edit="${t.id}">Editar</button><button class="btn sm danger" data-rm="${t.id}">Eliminar</button></div></div>`;
  }).join('');
  document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>editTrip(b.dataset.edit));
  document.querySelectorAll('[data-rm]').forEach(b=>b.onclick=()=>{
    if(!confirm('¿Eliminar este viaje? Se descontarán sus kilómetros y contadores.'))return;
    S.trips=S.trips.filter(t=>t.id!==b.dataset.rm);save();renderAll();
  });
}
['hPer','hDrv','hType'].forEach(id=>$(id).onchange=renderHistory);
function editTrip(id){
  const t=S.trips.find(x=>x.id===id);if(!t)return;
  go('reg');editingId=id;
  fillDriverSelects();
  $('fDriver').value=t.driverId;$('fZone').value=t.zone;$('fOrders').value=t.orders;
  $('fType').value=t.type;$('fOut').value=t.kmOut;$('fBack').value=t.kmBack;
  $('fDep').value=t.depart||'';$('fRet').value=t.returnEta||'';
  $('fForced').checked=!!t.forced;$('fNote').value=t.note||'';
  $('formTitle').textContent='Editar viaje';$('btnSave').textContent='Guardar cambios';
  $('btnCancel').style.display='block';updPrev();
}

// ---------- Resumen ----------
$('rate').onchange=()=>{const v=parseFloat($('rate').value);S.rate=v>=0?v:0;save();renderSummary()};
function renderSummary(){
  const st=stats();
  const rate=S.rate||0;
  const tk=st.reduce((a,s)=>a+s.km,0),to=st.reduce((a,s)=>a+s.orders,0);
  const cnt={cercano:0,medio:0,lejano:0,forced:0};
  st.forEach(s=>{cnt.cercano+=s.n.cercano;cnt.medio+=s.n.medio;cnt.lejano+=s.n.lejano;cnt.forced+=s.forced});
  $('teamBox').innerHTML=`<div class="card"><h2>Equipo — esta semana</h2><div class="grid2">
    <div class="stat"><span class="mut">Km totales</span><span class="num">${fmt(tk)}</span></div>
    <div class="stat"><span class="mut">Km por pedido</span><span class="num">${to?fmt(tk/to):0}</span></div>
    <div class="stat"><span class="mut">Cercanos / Medios</span><span class="num">${cnt.cercano} / ${cnt.medio}</span></div>
    <div class="stat"><span class="mut">Lejanos / Forzados</span><span class="num">${cnt.lejano} / ${cnt.forced}</span></div>
    <div class="stat" style="grid-column:1/-1"><span class="mut">Gasolina estimada del equipo</span><span class="num">${money(tk*rate)}</span></div>
  </div></div>`;
  $('sumList').innerHTML=st.slice().sort(prioSort).map(s=>`<div class="card"><h2>${esc(s.d.name)}</h2><div class="grid2">
    <div class="stat"><span class="mut">Km totales</span><span class="num">${fmt(s.km)}</span></div>
    <div class="stat"><span class="mut">Km por pedido</span><span class="num">${s.orders?fmt(s.km/s.orders):0}</span></div>
    <div class="stat"><span class="mut">Cercanos / Medios</span><span class="num">${s.n.cercano} / ${s.n.medio}</span></div>
    <div class="stat"><span class="mut">Lejanos / Forzados</span><span class="num">${s.n.lejano} / ${s.forced}</span></div>
    <div class="stat" style="grid-column:1/-1"><span class="mut">Gasolina estimada</span><span class="num">${money(s.km*rate)}</span></div>
  </div>${s.far>100?`<div class="warn">⚠ ${fmt(s.far)} km en viajes lejanos: pasa de 100 km esta semana</div>`:''}</div>`).join('');
}

// ---------- Datos ----------
function download(name,text,mime){
  const blob=new Blob([text],{type:mime});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;
  document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},500);
}
const stamp=()=>new Date().toISOString().slice(0,10);
$('btnCsv').onclick=()=>{
  const q=v=>'"'+String(v==null?'':v).replace(/"/g,'""')+'"';
  const head=['Fecha','Hora registro','Repartidor','Zona','Pedidos','Km ida','Km regreso','Km redondos','Km por pedido','Tipo','Forzado','Salida','Regreso estimado','Nota'];
  const rows=S.trips.slice().sort((a,b)=>a.ts-b.ts).map(t=>{
    const d=new Date(t.ts);
    return [d.toLocaleDateString('es-MX'),d.toLocaleTimeString('es-MX'),drvName(t.driverId),t.zone,t.orders,t.kmOut,t.kmBack,t.kmTotal,r1(t.kmPerOrder),TL[t.type],t.forced?'Sí':'No',t.depart,t.returnEta,t.note].map(q).join(',');
  });
  download('viajes_'+stamp()+'.csv','\uFEFF'+head.map(q).join(',')+'\n'+rows.join('\n'),'text/csv;charset=utf-8');
};
$('btnJson').onclick=()=>download('respaldo_repartidores_'+stamp()+'.json',JSON.stringify(S,null,2),'application/json');
$('btnImport').onclick=()=>$('fileImport').click();
$('fileImport').onchange=e=>{
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=()=>{
    try{
      const o=JSON.parse(r.result);
      if(!o||!Array.isArray(o.drivers)||!Array.isArray(o.trips))throw 0;
      if(!confirm('Esto reemplazará los datos actuales con el respaldo. ¿Continuar?'))return;
      S={drivers:o.drivers,trips:o.trips,rate:typeof o.rate==='number'?o.rate:2.5};
      save();resetForm();renderAll();toast('Respaldo restaurado ✔');
    }catch(err){alert('El archivo no es un respaldo válido.')}
  };
  r.readAsText(f);e.target.value='';
};
$('btnWipe').onclick=()=>{
  const n=weekTrips().length;
  if(!n)return alert('No hay viajes esta semana.');
  if(!confirm(`¿Borrar los ${n} viajes de esta semana? Los repartidores se conservan. Esta acción no se puede deshacer.`))return;
  const ws=weekStart(Date.now());
  S.trips=S.trips.filter(t=>t.ts<ws);save();renderAll();toast('Semana borrada');
};

// ---------- Render general ----------
function renderAll(){
  fillDriverSelects();renderDrivers();renderHistory();renderSummary();
  $('rate').value=S.rate;
}
resetForm();renderAll();
})();
</script>
